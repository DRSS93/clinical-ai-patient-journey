flowchart TD
    A["Clinical note (free text)"] --> B["LLM extracts information ONLY\n(no treatment recommendation, no diagnosis)"]
    B --> C["Structured clinical fields\n(has_extraction, has_denture, symptoms, dates, etc.)"]
    C --> D{"Escalation check\n(symptom keywords, contradictions)"}
    D -- "Triggered" --> E["STOP - route to human clinician\n(cannot be overridden by any other logic)"]
    D -- "Not triggered" --> F["Deterministic rules engine\n(recency thresholds + path logic)"]
    F --> G{"Confident match found?"}
    G -- "No" --> H["Insufficient information -\nrequest clarification"]
    G -- "Yes" --> I["Recommended next workflow step\n+ confidence label + reasoning"]

    style E fill:#f4cccc,stroke:#990000
    style D fill:#fff3cd,stroke:#b38600
    style F fill:#1F4E79,color:#ffffff
    style B fill:#e8f0fe,stroke:#4472c4
